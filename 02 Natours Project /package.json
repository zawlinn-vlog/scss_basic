{
  "name": "02-natours-project-",
  "version": "1.0.0",
  "description": "> I'm Zaw Linn Tun a Frontend Web Developer on [Zaw Linn Tun](https://www.facebook.com/zawlinn.profile). :heart:",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch:sass": "sass ./assets/scss/main.scss ./assets/css/style.css -w",
    "compile:sass": "sass ./assets/scss/main.scss ./assets/css/style.comp.css",
    "concat:css": "concat -o ./assets/css/style.concat.css ./assets/icon/lineaio/linea_icon.css ./assets/css/style.comp.css",
    "prefix:css": "postcss ./assets/css/style.comp.css --use autoprefixer -o ./assets/css/style.prefix.css",
    "compress:css": "sass ./assets/css/style.prefix.css ./assets/css/style.min.css --style=compressed --no-source-map",
    "server": "live-server",
    "start": "npm-run-all --parallel server watch:sass"
  },
  "keywords": [],
  "author": "Jonas Schmedtmann",
  "license": "ISC",
  "browserslist": [
    "cover 99.5%, not dead"
  ],
  "type": "commonjs",
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "concat": "^1.0.3",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "sass": "^1.102.0"
  }
}
