{
  "name": "05-trillo-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "server": "live-server",
    "watch:sass": "sass ./assets/scss/main.scss ./assets/css/style.css -w --no-source-map",
    "compile:sass": "sass ./assets/scss/main.scss ./assets/css/style.comp.css  --no-source-map",
    "prefix:css": "postcss ./assets/css/style.comp.css --use autoprefixer -o ./assets/css/style.prefix.css",
    "compress:css": "sass ./assets/css/style.prefix.css ./assets/css/style.min.css --style=compressed --no-source-map",
    "start": "npm-run-all --parallel server watch:sass"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "browserslist": [
    "cover 99.5%, not dead"
  ],
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "concat": "^1.0.3",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "sass": "^1.103.1"
  }
}
